# Application
APP_NAME=fiber-boilerplate
APP_ENV=development
APP_PORT=8080
APP_HOST=127.0.0.1
SHUTDOWN_TIMEOUT=30s

# Database
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/fiber_boilerplate?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m
DATABASE_CONN_MAX_IDLE_TIME=3m

# Redis (optional - falls back to in-memory cache if not set)
REDIS_URL=

# Object Storage / S3
# Set S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and S3_BUCKET to enable S3.
# Leave S3_ENDPOINT blank for AWS S3; set it to http://localhost:9000 for MinIO.
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_FORCE_PATH_STYLE=false
# Local fallback storage (used when S3 is not configured)
STORAGE_PATH="storage"
# Public base URL used to build local fallback file URLs
PUBLIC_URL="http://localhost:8080"

# JWT
JWT_SECRET=your-string-jwt-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=720h

# Rate Limitting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_EXPIRATION=60s
RATE_LIMIT_STRATEGY=ip

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=debug
LOG_OUTPUT=stdout
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

# OpenTelemtry (Optional)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SAMPLE_RATE=1.0

# Swagger
SWAGGER_ENABLED=true