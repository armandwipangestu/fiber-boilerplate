logging {
  level = "info"
}

local.file_match "fiber_boilerplate_logs" {
  path_targets = [
    { "__path__" = "/logs/*.log" },
  ]
}

loki.source.file "fiber_boilerplate" {
  targets    = local.file_match.fiber_boilerplate_logs.targets
  forward_to = [loki.process.fiber_boilerplate.receiver]
}

loki.process "fiber_boilerplate" {
  stage.static_labels {
    values = {
      job          = "fiber-boilerplate",
      service_name = "fiber-boilerplate",
      env          = "development",
      hostname     = constants.hostname,
      instance     = "fiber-boilerplate",
    }
  }

  forward_to = [loki.write.to_loki.receiver]
}

loki.write "to_loki" {
  endpoint {
    url = "http://loki-fiber-boilerplate:3100/loki/api/v1/push"
  }
}