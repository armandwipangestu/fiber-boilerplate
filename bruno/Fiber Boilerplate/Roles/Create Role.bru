meta {
  name: Create Role
  type: http
  seq: 2
}

post {
  url: {{host}}/api/v1/roles
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "editor",
    "description": "Can manage content"
  }
}

script:post-response {
  const body = res.getBody();
  const roleId = body?.data?.id;

  if (roleId) {
    bru.setEnvVar("role_id", roleId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}