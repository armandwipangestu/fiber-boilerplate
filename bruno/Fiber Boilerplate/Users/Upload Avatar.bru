meta {
  name: Upload Avatar
  type: http
  seq: 6
}

post {
  url: {{host}}/api/v1/users/{{user_id}}/avatar
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:multipart-form {
  avatar: @file(/path/to/avatar.png)
}

settings {
  encodeUrl: true
  timeout: 0
}