meta {
  name: Refresh
  type: http
  seq: 3
}

post {
  url: {{host}}/api/v1/auth/refresh
  body: json
  auth: inherit
}

script:post-response {
  const body = res.getBody();
  const token = body?.data?.access_token;

  if (token) {
    bru.setEnvVar("access_token", token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}