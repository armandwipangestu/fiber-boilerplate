meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{host}}/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  const token = body?.data?.access_token;
  const userId = body?.data?.user?.id;
  const name = body?.data?.user?.name;

  if (token) {
    bru.setEnvVar("access_token", token);
  }
  if (userId) {
    bru.setEnvVar("user_id", userId);
  }
  if (name) {
    bru.setEnvVar("name", name);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}